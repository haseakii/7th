{
  "Scheduler": {
    "Enable": {
      "type": "checkbox",
      "value": false
    },
    "NextRun": {
      "type": "datetime",
      "value": "2020-01-01 00:00:00"
    },
    "Command": {
      "type": "input",
      "value": "SecretShop",
      "display": "hide"
    },
    "SuccessInterval": {
      "type": "input",
      "value": 0,
      "display": "hide"
    },
    "FailureInterval": {
      "type": "input",
      "value": 120,
      "display": "hide"
    },
    "ServerUpdate": {
      "type": "input",
      "value": "00:00",
      "display": "hide"
    }
  },
  "SecretShop": {
    "ShopItems": {
      "BuyBookmarks": {
        "type": "checkbox",
        "value": true
      },
      "BuyMysticMedals": {
        "type": "checkbox",
        "value": true
      },
      "BuyEquipment": {
        "type": "checkbox",
        "value": false
      },
      "BuyFodder": {
        "type": "checkbox",
        "value": false
      }
    },
    "RefreshSettings": {
      "MaxRefreshCount": {
        "type": "input",
        "value": 200
      },
      "MaxSkystoneSpend": {
        "type": "input",
        "value": 0
      }
    },
    "Thresholds": {
      "GoldThreshold": {
        "type": "input",
        "value": 0
      },
      "SkystoneThreshold": {
        "type": "input",
        "value": 0
      }
    },
    "StopConditions": {
      "MaxBookmarks": {
        "type": "input",
        "value": 0
      },
      "MaxMysticMedals": {
        "type": "input",
        "value": 100
      }
    }
  },
  "Device": {
    "Connection": {
      "Serial": {
        "type": "input",
        "value": "127.0.0.1:16384"
      },
      "ScreenshotMethod": {
        "type": "select",
        "value": "auto",
        "option": ["auto", "adb", "adb_nc", "uiautomator2", "ascreencap", "ascreencap_nc", "droidcast", "droidcast_raw", "nemu_ipc", "ldopengl"]
      },
      "ControlMethod": {
        "type": "select",
        "value": "auto",
        "option": ["auto", "adb", "uiautomator2", "minitouch", "hermit", "maatouch"]
      },
      "OcrMethod": {
        "type": "select",
        "value": "rapidocr",
        "option": ["rapidocr", "easyocr", "paddleocr", "alas"]
      }
    }
  },
  "Webui": {
    "Server": {
      "WebuiPort": {
        "type": "input",
        "value": 8080
      }
    }
